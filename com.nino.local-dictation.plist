<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nino.local-dictation</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/nino/Workspace/dev/wip/local-dictation/.venv/bin/python</string>
